{% extends "layout.twig" %}

{% block title %}Список привычек{% endblock %}

{% block content %}
<div class="card">
    <form class="search" method="get">
        <input type="hidden" name="page" value="list">
        <input type="hidden" name="view" value="twig">

        <input 
            type="text" 
            name="q" 
            placeholder="Поиск по названию, описанию или категории"
            value="{{ query }}"
        >

        <button class="btn" type="submit">Искать</button>
    </form>

    {% if records is empty %}
        <p>Записей пока нет.</p>
    {% else %}
        <table>
            <thead>
            <tr>
                <th>ID</th>
                <th>Название</th>
                <th>Категория</th>
                <th>Сложность</th>
                <th>Дата начала</th>
                <th>Цель</th>
                <th>Дни</th>
                <th>Действия</th>
            </tr>
            </thead>

            <tbody>
            {% for record in records %}
                <tr>
                    <td>{{ record.id }}</td>
                    <td>{{ record.name }}</td>
                    <td>{{ record.category_name }}</td>
                    <td>{{ difficulties[record.difficulty] ?? record.difficulty }}</td>
                    <td>{{ record.start_date }}</td>
                    <td>{{ record.goal_days|goal_duration }}</td>
                    <td>
                        {% for day in record.days %}
                            {{ dayLabels[day] ?? day }}
                        {% endfor %}
                    </td>
                    <td>
                        <div class="actions">
                            <a class="btn btn-warning" href="edit.php?id={{ record.id }}&view=twig">
                                Редактировать
                            </a>

                            <form class="inline-form" method="post" action="delete.php" onsubmit="return confirm('Удалить запись?');">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                <input type="hidden" name="id" value="{{ record.id }}">
                                <input type="hidden" name="view" value="twig">

                                <button class="btn btn-danger" type="submit">
                                    Удалить
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
</div>
{% endblock %}